# =============================================================================
# ARQUIVO DE EXEMPLO DE CONFIGURAÇÃO - .env.example
# =============================================================================
# Este arquivo contém as variáveis de ambiente necessárias para configurar
# e executar o ambiente Docker do Frappe/ERPNext.
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Edite o arquivo .env com suas configurações específicas
# 3. NUNCA commite o arquivo .env no Git (ele contém senhas reais)
# 4. Gere senhas fortes para produção usando: openssl rand -base64 32
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DO PROJETO DOCKER
# -----------------------------------------------------------------------------
# Nome do projeto Docker (usado como prefixe para containers e volumes)
DOCKER_PROJECT_NAME=smi

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE IMAGENS
# -----------------------------------------------------------------------------
# Imagem Docker customizada do Frappe/ERPNext
# Formato: nome-da-imagem:versão
DOCKER_IMAGE=arteris-smi:1.0.0

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DO BANCO DE DADOS
# -----------------------------------------------------------------------------
# Senha do usuário root do MySQL/MariaDB
# IMPORTANTE: Use senhas fortes e únicas em produção!
# Gere com: openssl rand -base64 32
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DO ADMINISTRADOR
# -----------------------------------------------------------------------------
# Senha do administrador do Frappe/ERPNext (usuário Administrator)
# IMPORTANTE: Esta é a senha de acesso ao sistema!
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO SFTP
# -----------------------------------------------------------------------------
# Porta externa para acesso SFTP
SFTP_PORT=6522

# Credenciais do usuário SFTP
# IMPORTANTE: Altere usuário e senha padrão!
SFTP_USER=arteris
SFTP_PASSWORD=CHANGE_ME_SFTP_PASSWORD

# Diretórios do SFTP
# Pasta no host que será montada no container
SFTP_FOLDER=/ftp/arteris
# Pasta dentro do container onde os arquivos ficarão
SFTP_TARGET_FOLDER=/home/arteris/upload

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DO REDIS
# -----------------------------------------------------------------------------
# Hosts do Redis para cache e filas
# Formato: hostname:porta
REDIS_CACHE_HOST=redis-cache:6379
REDIS_QUEUE_HOST=redis-queue:6379

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE CONEXÃO DO BANCO DE DADOS
# -----------------------------------------------------------------------------
# Host e porta do banco de dados (nome do serviço Docker)
DB_HOST=db
DB_PORT=3306

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DO SOCKET.IO
# -----------------------------------------------------------------------------
# Porta do serviço de WebSocket
SOCKETIO_PORT=9000

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DO SITE
# -----------------------------------------------------------------------------
# Nome do domínio do site (usado para acesso HTTPS)
# IMPORTANTE: Altere para seu domínio real!
SITE_NAME=smi.arteris.com.br

# Origens permitidas para conexões WebSocket (CORS)
# Use a mesma URL do SITE_NAME com https://
ALLOWED_ORIGINS=https://smi.arteris.com.br

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE REDE DOCKER
# -----------------------------------------------------------------------------
# Nome da rede Docker compartilhada entre os containers
DOCKER_NETWORK=smi_default

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE VOLUMES DOCKER
# -----------------------------------------------------------------------------
# Nomes dos volumes Docker para persistência de dados
# Formato: nome-do-projeto_tipo-de-volume

# Volume para aplicações Frappe
DOCKER_VOLUME_APPS=smi_apps

# Volume para dados do banco de dados
DOCKER_VOLUME_DB=smi_db-data

# Volume para dados de fila do Redis
DOCKER_VOLUME_REDIS_QUEUE=smi_redis-queue-data

# Volume para sites Frappe
DOCKER_VOLUME_SITES=smi_sites

# Volume para chaves SSH do SFTP
DOCKER_VOLUME_SFTP_SSH_KEYS=smi_sftp-ssh-keys

# Volumes adicionais
DOCKER_VOLUME_ASSETS=assets
DOCKER_VOLUME_BACKUPS=backups
DOCKER_VOLUME_CONFIG=config
DOCKER_VOLUME_LOGS=logs
DOCKER_VOLUME_COMMON=common

# =============================================================================
# NOTAS DE SEGURANÇA
# =============================================================================
# 1. SEMPRE altere as senhas padrão antes de usar em produção
# 2. Use senhas fortes com no mínimo 16 caracteres
# 3. Mantenha o arquivo .env seguro e nunca o versione no Git
# 4. Configure permissões adequadas: chmod 600 .env
# 5. Use diferentes senhas para cada serviço
# 6. Faça backup regular das senhas em local seguro
#
# COMANDOS ÚTEIS:
# - Gerar senha aleatória: openssl rand -base64 32
# - Verificar .env no .gitignore: grep .env .gitignore
# - Proteger arquivo .env: chmod 600 .env
# =============================================================================

{
  "name": "SMI Data Connector",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "smi-data-connector-api",
  "workspaceFolder": "/app",

  // Sobrescrever o comando padrão para manter o container rodando
  "overrideCommand": true,

  // Configurações do VSCode
  "customizations": {
    "vscode": {
      // Extensões recomendadas
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-python.black-formatter",
        "ms-python.isort",
        "charliermarsh.ruff"
      ],

      // Configurações do editor
      "settings": {
        "python.defaultInterpreterPath": "/home/appuser/.local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.formatting.provider": "black",
        "python.testing.pytestEnabled": true,
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "files.exclude": {
          "**/__pycache__": true,
          "**/*.pyc": true
        }
      }
    }
  },

  // Configuração de debug
  "features": {},

  // Executar como root para ter permissões adequadas
  "remoteUser": "root",

  // Post create command - instalar dependências de desenvolvimento
  "postCreateCommand": "pip install debugpy pytest pytest-cov ipython",

  // Forward da porta da API
  "forwardPorts": [8085],

  // Mounts adicionais (se necessário)
  "mounts": [
    "source=${localEnv:HOME}/.aws,target=/root/.aws,type=bind,consistency=cached"
  ]
}

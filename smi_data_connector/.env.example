# SMI Data Connector - Environment Configuration
# Copy this file to .env and fill with your credentials

# ====================================
# API ARTERIS
# ====================================
ARTERIS_API_BASE_URL=https://development.localhost
ARTERIS_API_TOKEN=your_token_here
DISABLE_SSL_VERIFY=false

# ====================================
# AWS CONFIGURATION (for Kartado)
# ====================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_OUTPUT_LOCATION=s3://your-bucket/path/

# ====================================
# OSIRIS CONFIGURATION
# ====================================
OSIRIS_LOGIN=your_email@example.com
OSIRIS_PASSWORD=your_password

# ====================================
# CRON CONFIGURATION
# ====================================
# Horários em formato 24h (será ajustado automaticamente para o timezone do sistema)
# Todos os horários são referentes ao horário de São Paulo (UTC-3)

# Horário para execução das tarefas diárias (SAP Order → FTD → Kartado → Osiris)
CRON_DAILY_HOUR=22
CRON_DAILY_MINUTE=0

# Intervalo para execução do Adobe (em minutos)
# 0 = desabilitado, 60 = a cada hora, 30 = a cada 30 minutos, etc
CRON_ADOBE_INTERVAL=60

# Configuração legada (descontinuada - use CRON_DAILY_HOUR e CRON_DAILY_MINUTE)
# CRON_SCHEDULE=0 21 * * *
ENABLE_CRON=true

# ====================================
# LOGGING
# ====================================
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_FILE_MAX_SIZE_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# ====================================
# FTP PATH (optional)
# ====================================
FTP_PATH=/ftp/arteris